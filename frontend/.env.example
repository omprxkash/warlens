# Backend API base URL used by the React frontend.
# Override in .env.local for development or set in your deployment environment.
REACT_APP_API_URL=http://localhost:5000

# --- Backend env vars (read by backend/app.py) ---
# Override the model directory (defaults to <repo>/model).
# WARLENS_MODEL_DIR=/path/to/models

# Tighten CORS in production. Defaults to "*" (open). Comma-separated origins.
# WARLENS_CORS_ORIGINS=https://warlens.example.com,https://staging.warlens.example.com

# Enable Flask debug mode (DEV ONLY — never set in production).
# FLASK_DEBUG=0
